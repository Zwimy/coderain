# Copy this file to ".env" and fill in the key for whichever profile you use.
# Local Ollama needs no real key (leave the dummy).

OLLAMA_API_KEY=ollama

# The Settings page writes HOSTED_API_KEY when you add a hosted provider
# (srv/core.py, HOSTED_KEY_ENV), so this is the usual one to fill in.
HOSTED_API_KEY=

# Only needed when you point a profile at one of these yourself in config.yaml.
OPENROUTER_API_KEY=
CUSTOM_API_KEY=
